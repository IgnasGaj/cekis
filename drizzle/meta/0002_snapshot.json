      "checkConstraints": {
        "purchase_product_name_check": {
          "name": "purchase_product_name_check",
          "value": "length(\"purchase\".\"product_name\") between 1 and 200 and \"purchase\".\"product_name\" = btrim(\"purchase\".\"product_name\")"
        },
        "purchase_seller_check": {
          "name": "purchase_seller_check",
          "value": "length(\"purchase\".\"seller\") between 1 and 200 and \"purchase\".\"seller\" = btrim(\"purchase\".\"seller\")"
        },
        "purchase_notes_check": {
          "name": "purchase_notes_check",
          "value": "\"purchase\".\"notes\" is null or length(\"purchase\".\"notes\") <= 2000"
        },
        "purchase_price_check": {
          "name": "purchase_price_check",
          "value": "\"purchase\".\"price\" is null or (\"purchase\".\"price\" >= 0 and \"purchase\".\"price\" <= 9999999999.99)"
        },
        "purchase_currency_check": {
          "name": "purchase_currency_check",
          "value": "(\"purchase\".\"price\" is null and \"purchase\".\"currency\" is null) or (\"purchase\".\"price\" is not null and \"purchase\".\"currency\" in ('EUR','USD','GBP','PLN'))"
        }
      },
