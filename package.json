{
  "name": "cekis",
  "version": "0.1.0",
  "scripts": {
    "test": "vitest run",
    "test:lint-rules": "node scripts/check-lint-rules.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "mail:dev": "mailpit --smtp 127.0.0.1:1025 --listen 127.0.0.1:1080",
    "db:grant": "node scripts/grant-app.mjs",
    "setup:local": "node scripts/setup-local.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IgnasGaj/cekis.git"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.7",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.52.0",
    "next": "^16.3.8",
    "nodemailer": "^10.0.15",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@next/eslint-plugin-next": "file:vendor/eslint-plugin-next",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "@next/eslint-plugin-next": "$@next/eslint-plugin-next"
  }
}
