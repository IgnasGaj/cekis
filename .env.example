# Copy to .env.local. Use a separate limited application role in deployed environments.
DATABASE_URL=postgres://cekis_app:CHANGE_ME@127.0.0.1:5433/cekis
MIGRATION_DATABASE_URL=postgres://cekis_owner:CHANGE_ME@127.0.0.1:5433/cekis
LOCAL_DB_PASSWORD=CHANGE_ME
APP_URL=http://127.0.0.1:3100
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM="Čekis <prisijungimas@cekis.local>"
# Set both only for an authenticated external SMTP provider.
# SMTP_USER=
# SMTP_PASSWORD=
# Reminder sending is separately enabled after sender configuration.
REMINDER_TRANSPORT_ENABLED=false
# At least 32 random characters; send only in the Authorization header.
# REMINDER_WORKER_SECRET=
AUTH_SEND_LIMIT=5
AUTH_SEND_WINDOW_SECONDS=3600
RECEIPT_UPLOADS_PER_HOUR=20
RECEIPT_ATTEMPTS_PER_HOUR=60
# Private S3-compatible bucket. The local test service uses 127.0.0.1:9000.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=cekis-local
S3_ACCESS_KEY_ID=CHANGE_ME_S3_USER
S3_SECRET_ACCESS_KEY=CHANGE_ME_S3_SECRET
LOCAL_S3_ACCESS_KEY_ID=CHANGE_ME_S3_USER
LOCAL_S3_SECRET_ACCESS_KEY=CHANGE_ME_S3_SECRET
