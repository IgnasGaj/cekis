# Copy to .env.local. Use a separate limited application role in deployed environments.
DATABASE_URL=postgres://cekis_app:CHANGE_ME@127.0.0.1:5433/cekis
MIGRATION_DATABASE_URL=postgres://cekis_owner:CHANGE_ME@127.0.0.1:5433/cekis
LOCAL_DB_PASSWORD=CHANGE_ME
APP_URL=http://127.0.0.1:3100
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM="Čekis <prisijungimas@cekis.local>"
# Set both only for an authenticated external SMTP provider.
# SMTP_USER=
# SMTP_PASSWORD=
AUTH_SEND_LIMIT=5
AUTH_SEND_WINDOW_SECONDS=3600
